+
+#include "oran-command.h"
+
+namespace ns3
+{
+
+/**
+ * @ingroup oran
+ * A Command instructing an LTE eNB to handover a UE to another LTE eNB.
+ * In this command the Target E2 Node ID is the serving LTE eNB, and the command
+ * contains the cell ID of the eNB to handover to, and the RNTI of the UE to be
+ * handoverd.
+ */
+class OranCommandSetPrb : public OranCommand
+{
+  public:
+    /**
+     * Gets the TypeId of the OranCommandSetPrb class.
+     *
+     * @return The TypeId.
+     */
+    static TypeId GetTypeId();
+    /**
+     * Creates an instance of the OranCommandSetPrb class.
+     */
+    OranCommandSetPrb();
+    /**
+     * The destructor of the OranCommandSetPrb class.
+     */
+    ~OranCommandSetPrb() override;
+
+    std::string ToString() const override;
+
+  private:
+    /**
+     * The ID of the cell to handover to.
+     */
+    uint16_t m_prb;
+    /**
+     * The RNTI of the UE to handover.
+     */
+
+  public:
+    /**
+     * Gets the ID of the cell to handover to.
+     *
+     * @returns The cell ID.
+     */
+    uint16_t GetPrb() const;
+    /**
+     * Gets the RNTI of the UE to handover.
+     *
+     * @returns The RNTI.
+     */
+}; // class OranCommandSetPrb
+
+} // namespace ns3
+
+#endif /* ORAN_COMMAND_SET_PRB_H */
