+void
+OranDataRepositorySqlite::SaveThroughput(uint64_t e2NodeId, double mbps, Time t)
+{
+    if (m_active && IsNodeRegistered(e2NodeId))
+    {
+        sqlite3_stmt* stmt = nullptr;
+        std::string query = "INSERT INTO nodethroughput (nodeid, mbps, simulationtime) VALUES (?, ?, ?);";
+        sqlite3_prepare_v2(m_db, query.c_str(), -1, &stmt, 0);
+        sqlite3_bind_int64(stmt, 1, e2NodeId);
+        sqlite3_bind_double(stmt, 2, mbps);
+        sqlite3_bind_int64(stmt, 3, t.GetTimeStep());
+        int rc = sqlite3_step(stmt);
+        CheckQueryReturnCode(stmt, rc, FormatBoundArgsList(e2NodeId, mbps, t.GetTimeStep()));
+        sqlite3_finalize(stmt);
+    }
+}
+
+std::vector<std::pair<Time, double>>
+OranDataRepositorySqlite::GetThroughput(uint64_t e2NodeId, uint32_t n)
+{
+    std::vector<std::pair<Time, double>> out;
+    if (m_active && IsNodeRegistered(e2NodeId))
+    {
+        sqlite3_stmt* stmt = nullptr;
+        std::string query = "SELECT simulationtime, mbps FROM nodethroughput WHERE nodeid = ? "
+                            "ORDER BY entryid DESC LIMIT ?;";
+        sqlite3_prepare_v2(m_db, query.c_str(), -1, &stmt, 0);
+        sqlite3_bind_int64(stmt, 1, e2NodeId);
+        sqlite3_bind_int64(stmt, 2, n);
+        int rc;
+        while ((rc = sqlite3_step(stmt)) == SQLITE_ROW)
+        {
+            out.emplace_back(Time(sqlite3_column_int64(stmt, 0)), sqlite3_column_double(stmt, 1));
+        }
+        CheckQueryReturnCode(stmt, rc, FormatBoundArgsList(e2NodeId, n));
+        sqlite3_finalize(stmt);
+    }
+    return out;
+}
