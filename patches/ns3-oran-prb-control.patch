+OranReportThroughput::~OranReportThroughput()
+{
+    NS_LOG_FUNCTION(this);
+}
+
+std::string
+OranReportThroughput::ToString() const
+{
+    NS_LOG_FUNCTION(this);
+
+    std::stringstream ss;
+    Time time = GetTime();
+
+    ss << "OranReportThroughput("
+       << "E2NodeId=" << GetReporterE2NodeId() << ";Time=" << time.As(Time::S) << ";ThroughputMbps=" << m_thr
+       << ")";
+
+    return ss.str();
+}
+
+double
+OranReportThroughput::GetThroughputMbps() const
+{
+    NS_LOG_FUNCTION(this);
+
+    return m_thr;
+}
+
+} // namespace ns3
